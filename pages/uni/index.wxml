<view class="uni-page">
  <view class="uni-head">
    <view><view class="uni-brand"><text class="star">✦</text> Uni</view><view class="uni-copy">本机校园助手</view></view>
    <button class="history-button" bindtap="showHistory">历史</button>
  </view>
  <scroll-view class="messages" scroll-y scroll-into-view="message-end">
    <view wx:if="{{!messages.length}}" class="welcome">
      <view class="welcome-star">✦</view><view class="welcome-title">你好，我是 Uni</view>
      <view class="welcome-copy">问问课程安排、记事用法或校园服务。</view>
    </view>
    <view wx:for="{{messages}}" wx:key="id" class="message {{item.role}}"><view class="bubble">{{item.text}}</view></view>
    <view id="message-end"></view>
  </scroll-view>
  <view wx:if="{{keyboardHint}}" class="voice-hint">{{keyboardHint}}</view>
  <view class="composer">
    <button class="voice" bindtap="openKeyboardVoice">⌁</button>
    <input value="{{text}}" bindinput="updateText" bindfocus="openKeyboardVoice" confirm-type="send" bindconfirm="send" placeholder="和 Uni 说点什么…" />
    <button class="send" bindtap="send" disabled="{{!text}}">发送</button>
  </view>
</view>

<view wx:if="{{historyOpen}}" class="mask" bindtap="hideHistory">
  <view class="history-sheet" catchtap="noop">
    <view class="sheet-head"><text>历史记录</text><text class="close" bindtap="hideHistory">完成</text></view>
    <scroll-view class="history-list" scroll-y>
      <view wx:if="{{!messages.length}}" class="empty">暂无历史记录</view>
      <view wx:for="{{messages}}" wx:key="id" class="history-row"><text>{{item.role === 'user' ? '你' : 'Uni'}}</text><view>{{item.text}}</view></view>
    </scroll-view>
    <button wx:if="{{messages.length}}" class="clear" bindtap="clearHistory">清空历史记录</button>
  </view>
</view>
